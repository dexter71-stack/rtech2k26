# Copie este arquivo para .env e ajuste os valores.
# Gere um JWT_SECRET seguro com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=3000

# Banco MySQL/MariaDB local
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=galeto_gestao

# Autenticação
JWT_SECRET=
JWT_EXPIRES=8h
COOKIE_NAME=gg_token
